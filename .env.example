# Database Configuration (TiDB Cloud Serverless or Localhost)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=it_service_desk
DB_USERNAME=xxxxxx.root
DB_PASSWORD=your_tidb_password_here
DB_SSL=true

# App Configuration
APP_ENV=production
APP_DEBUG=false

# Remote support: deploy the relay behind TLS; use the SAME random secret on both services.
REMOTE_PUBLIC_URL=https://your-taskflow.example.com
REMOTE_RELAY_URL=wss://your-relay.example.com
REMOTE_RELAY_SECRET=replace-with-at-least-32-random-characters
REMOTE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Relay process only; its private listener must be reachable only through the TLS proxy.
REMOTE_BEHIND_TLS_PROXY=true
REMOTE_RELAY_HOST=127.0.0.1
